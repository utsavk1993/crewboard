generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SkillCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  skills Skill[]

  @@map("skill_categories")
}

/// A specialty within a category, e.g. Appliance Repair › Refrigerators.
model Skill {
  id         String        @id @default(uuid()) @db.Uuid
  name       String        @unique
  categoryId String        @map("category_id") @db.Uuid
  category   SkillCategory @relation(fields: [categoryId], references: [id])

  technicians TechnicianSkill[]
  jobs        Job[]

  @@index([categoryId])
  @@map("skills")
}

model TechnicianSkill {
  technicianId String     @map("technician_id") @db.Uuid
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skillId      String     @map("skill_id") @db.Uuid
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // The primary key covers lookups by technician; this index covers lookups by skill.
  @@id([technicianId, skillId])
  @@index([skillId])
  @@map("technician_skills")
}

model Province {
  code String @id
  name String @unique

  regions Region[]

  @@map("provinces")
}

/// A service region within a province, e.g. British Columbia › Metro Vancouver.
model Region {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  provinceCode String   @map("province_code")
  province     Province @relation(fields: [provinceCode], references: [code])

  cities City[]

  // The unique index also covers lookups by province.
  @@unique([provinceCode, name])
  @@map("regions")
}

model City {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  regionId String @map("region_id") @db.Uuid
  region   Region @relation(fields: [regionId], references: [id])

  technicians Technician[]
  jobs        Job[]

  // The unique index also covers lookups by region.
  @@unique([regionId, name])
  @@map("cities")
}

model Technician {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String   @unique
  phone       String
  designation String
  /// Home base.
  cityId      String   @map("city_id") @db.Uuid
  city        City     @relation(fields: [cityId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skills TechnicianSkill[]
  jobs   Job[]

  @@index([cityId])
  @@map("technicians")
}

model Job {
  id            String      @id @default(uuid()) @db.Uuid
  title         String
  description   String
  customerName  String      @map("customer_name")
  address       String
  /// Job site.
  cityId        String      @map("city_id") @db.Uuid
  city          City        @relation(fields: [cityId], references: [id])
  skillId       String      @map("skill_id") @db.Uuid
  skill         Skill       @relation(fields: [skillId], references: [id])
  priority      Priority
  scheduledDate DateTime    @map("scheduled_date") @db.Date
  technicianId  String?     @map("technician_id") @db.Uuid
  technician    Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  assignedAt    DateTime?   @map("assigned_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([technicianId])
  @@index([skillId])
  @@index([cityId])
  @@map("jobs")
}
