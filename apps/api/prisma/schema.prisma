generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Technician {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String   @unique
  phone       String
  designation String
  region      String
  skills      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@map("technicians")
}

model Job {
  id            String      @id @default(uuid()) @db.Uuid
  title         String
  description   String
  customerName  String      @map("customer_name")
  address       String
  requiredSkill String      @map("required_skill")
  priority      Priority
  scheduledDate DateTime    @map("scheduled_date") @db.Date
  technicianId  String?     @map("technician_id") @db.Uuid
  technician    Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  assignedAt    DateTime?   @map("assigned_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([technicianId])
  @@map("jobs")
}
